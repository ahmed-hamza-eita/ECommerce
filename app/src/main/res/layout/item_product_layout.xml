<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="product"
            type="com.hamza.ecommerce.ui.products.models.ProductUIModel" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/product_image"
            android:padding="4dp"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/edit_text_background"
            app:imageUrl="@{product.getFirstImage()}"
            tools:src="@drawable/product_placeholder" />


        <TextView
            android:id="@+id/product_name"
            style="@style/MediumTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="2"
            android:text="@{product.name}"
            android:textColor="@color/neutral_dark"
            tools:text="Product Name" />

        <androidx.appcompat.widget.AppCompatRatingBar
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:numStars="5"
            android:rating="@{product.rate}"
            android:stepSize="1"
            android:theme="@style/RatingBarStyle" />


        <TextView
            android:id="@+id/product_price"
            style="@style/MediumTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@{product.getFormattedPriceAfterSale()}"
            tools:text="200$" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_original_price"
                style="@style/SmallTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:foreground="@drawable/line_through_text"
                android:text="@{product.getFormattedPrice()}"
                tools:text="200$" />

            <TextView
                android:id="@+id/product_discount_percentage"
                style="@style/SmallTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="@{product.getFormattedSale()}"
                android:textColor="@color/primary_red"

                android:textStyle="bold"
                tools:text="25%" />

            <TextView
                style="@style/SmallTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/off"
                android:textColor="@color/primary_red"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</layout>